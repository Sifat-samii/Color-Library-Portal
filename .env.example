PORT=8787
HOST=0.0.0.0
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=color_library_portal
DB_USER=TUUO_ADMIN
DB_PASSWORD=YOUR_TUUO_ADMIN_PASSWORD
# Optional alternative to DB_* (used by server/database-config.js when set):
# DATABASE_URL=postgresql://TUUO_ADMIN:YOUR_TUUO_ADMIN_PASSWORD@127.0.0.1:5432/color_library_portal
SESSION_DAYS=7
MAX_SESSIONS_PER_USER=10
NODE_ENV=development
COOKIE_SECURE=false
TRUST_PROXY=false
# Production sign-in uses Google OpenID Connect. Register this exact callback URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/auth/google/callback
# Optional comma-separated Google Workspace domains. Leave empty to rely only on the pre-authorized email list.
GOOGLE_ALLOWED_DOMAINS=
# Password sign-in is a local-development fallback only. Keep false in production.
ALLOW_PASSWORD_LOGIN=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-7-or-more-characters
ADMIN_NAME=Pixofix Administrator
STORAGE_ROOT=./storage
CBI_IMPORT_FOLDER=F:\CBI\Approve
CBI_CLIENT_EMAIL=cbi@example.com
CBI_CLIENT_PASSWORD=replace-with-a-unique-password-of-7-or-more-characters
