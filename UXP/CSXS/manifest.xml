<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.pixofix.color-library" ExtensionBundleVersion="0.6.0" ExtensionBundleName="Pixofix Color Library" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
