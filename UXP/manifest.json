{
  "manifestVersion": 5,
  "id": "com.pixofix.color-library",
  "name": "Pixofix Color Library",
  "version": "0.5.0",
  "main": "index.html",
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon.png",
      "scale": [1, 2]
    }
  ],
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "requiredPermissions": {
    "clipboard": "readAndWrite",
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "http://127.0.0.1",
        "http://localhost",
        "http://tudb01",
        "http://192.168.0.112",
        "http://pixofix-library",
        "https://pixofix-library"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "pixofixColorLibraryPanel",
      "label": {
          "default": "Pixofix Color Library"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon_N.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon_D.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ],
      "minimumSize": {
        "width": 280,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 760
      },
      "maximumSize": {
        "width": 1200,
        "height": 1600
      }
    }
  ]
}
